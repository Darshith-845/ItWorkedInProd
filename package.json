{
  "name": "it-worked-in-prod-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:agent": "cd local-agent && npm install",
    "install:all": "npm run install:server && npm run install:client && npm run install:agent",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "agent": "cd local-agent && npm start"
  }
}
